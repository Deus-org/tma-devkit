{
  "name": "tma-devkit",
  "private": true,
  "bin": {
    "tma-devkit": "./dist-tma-devkit/cli.js"
  },
  "version": "0.1.0",
  "type": "module",
  "description": "Local emulator & bridge inspector for Telegram Mini Apps — mocked window.Telegram.WebApp, signed initData, theme/platform/user presets, live event inspector.",
  "keywords": [
    "telegram",
    "mini-apps",
    "tma",
    "devtools",
    "emulator",
    "debugging"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:tma-devkit": "tsc -p tma-devkit/tsconfig.json",
    "build:mcp": "cd mcp && npx tsc -p tsconfig.json",
    "build:all": "npm run build && npm run build:tma-devkit && npm run build:mcp",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify:hmac": "node scripts/verify-hmac.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.6.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}
